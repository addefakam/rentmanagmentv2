# Environment configuration
# Copy to .env and adjust for your environment.
#
# LOCAL DEVELOPMENT (default): SQLite, no server needed.
DATABASE_URL=file:./db/custom.db
#
# CLOUD (Vercel + Neon PostgreSQL): comment the line above and use your Neon
# connection string. When using Neon's pooled endpoint (-pooler host), add
# pgbouncer=true so Prisma disables prepared statements for PgBouncer:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true
